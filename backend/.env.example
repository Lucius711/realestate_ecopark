# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecopark
DB_PASSWORD=ecopark
DB_NAME=ecopark
# Production on Supabase: DB_SSL=true, DB_SYNC=false, and paste the connection string
# (Project Settings → Database) into DATABASE_URL instead of the DB_* lines.
DB_SSL=false
# Optional: one connection string instead of the DB_* lines (overrides them)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# set to false once you use migrations
DB_SYNC=true

# --- Server ---
PORT=4000
# Production only: number of proxies in front of the API (1 on Render/Railway/Fly), so per-IP limits see the real visitor IP.
# Leave empty locally.
TRUST_PROXY=
CORS_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# --- Auth (JWT) ---
# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# First admin account, created once by `npm run seed` — remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=tuan
ADMIN_PASSWORD=
# Optional: the Google / Facebook email allowed to sign in as this admin
ADMIN_EMAIL=

# --- "Tiếp tục với Google / Facebook" (leave empty to disable) ---
# Google: console.cloud.google.com → Credentials → OAuth client (Web)
#   Authorized redirect URI: {API_PUBLIC_URL}/login/oauth2/code/google   (local: http://localhost:4000/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: developers.facebook.com → app → Facebook Login
#   Valid OAuth Redirect URI: {API_PUBLIC_URL}/login/oauth2/code/facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Email: "Nhận thông báo căn mới" (Resend) ---
# Local: leave empty → emails are written to backend/mail-outbox/*.html instead of being sent.
# Production: API key from resend.com and a sender on a domain verified there.
RESEND_API_KEY=
MAIL_FROM=Nguyễn Hồng Tuấn <thongbao@tenmien.vn>

# --- File uploads (images, brochures) ---
# Local: leave empty → files are saved in backend/uploads and served at {API_PUBLIC_URL}/uploads/...
# Production: Cloudflare R2 (R2 → Manage API tokens → Object Read & Write), public bucket URL (r2.dev or custom domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
