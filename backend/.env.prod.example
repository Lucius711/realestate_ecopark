# Production env template. Copy to backend/.env.prod (git-ignored), fill in, then paste the whole file
# into the GitHub secret BACKEND_ENV_PROD; each deploy writes it to backend/.env.prod on the VPS.
NODE_ENV=production
PORT=4000

# Supabase → Connect → "Session pooler" (IPv4; the direct host is IPv6-only and Docker has no IPv6 by default).
# Don't set DATABASE_URL: it would override these. Special characters in the password are fine here (no URL encoding).
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.xxxx
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
# true: tables follow the code on each deploy (the app also migrates old columns before syncing).
DB_SYNC=true

# Cloudflare → Nginx → API: one proxy hop (Nginx already turns CF-Connecting-IP into the visitor IP)
TRUST_PROXY=1
CORS_ORIGIN=https://tenmien.vn,https://www.tenmien.vn
API_PUBLIC_URL=https://api.tenmien.vn
FRONTEND_URL=https://tenmien.vn

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=tuan
# Only for the first `seed`, then delete this line and restart.
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Redirect URIs: https://api.tenmien.vn/login/oauth2/code/google (and /facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

RESEND_API_KEY=
MAIL_FROM=Nguyễn Hồng Tuấn <thongbao@tenmien.vn>

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.tenmien.vn
